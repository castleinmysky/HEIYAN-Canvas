# 默认只在当前电脑提供服务。不填写任何作者账号或密钥。
HEIYAN_HOST=127.0.0.1
HEIYAN_PORT=8792
# 对外监听时，必须配置准确的访问来源和至少 16 字符的独立部署密码。
# HEIYAN_ORIGIN=https://canvas.your-domain.com
# HEIYAN_ACCESS_PASSWORD=replace-with-your-own-long-random-password
# 可选：限制云 API 的目标域名，逗号分隔；不支持通配符。
# HEIYAN_MODEL_HOSTS=api.openai.com,generativelanguage.googleapis.com
