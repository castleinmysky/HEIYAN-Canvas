{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heiyan:managed-comfy:installation-receipt:v1",
  "title": "InstallationReceiptV1",
  "description": "Private machine-local state. Store only at state/private/installation-receipt-v1.json inside the selected managed installation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storage", "bundle", "installation", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "installation-receipt/v1" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "private"],
      "properties": {
        "logicalPath": { "const": "state/private/installation-receipt-v1.json" },
        "private": { "const": true }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "installRoot", "modelRoots", "endpoint", "state", "verifiedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "installRoot": { "$ref": "#/$defs/localAbsolutePath" },
        "modelRoots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localAbsolutePath" } },
        "endpoint": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost):(?:[1-9][0-9]{0,4})$" },
        "state": { "enum": ["installed", "repair_required", "rolled_back"] },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "findings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["ready", "blocked"] },
          "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "localAbsolutePath": {
      "type": "string",
      "minLength": 3,
      "anyOf": [
        { "pattern": "^[A-Za-z]:[\\\\/](?![\\\\/]).+" },
        { "pattern": "^/(?!/).+" }
      ]
    }
  }
}
